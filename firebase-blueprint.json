{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Office staff profile and role (admin or documenter) for Al-Qarabulli Awqaf mosque documentation system.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth user UID."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Full display name of the staff member."
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 254,
          "description": "Staff email address used for authentication."
        },
        "role": {
          "type": "string",
          "enum": ["admin", "documenter"],
          "description": "Access role: admin (مدير) or documenter (موثِّق)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when user profile was created."
        },
        "createdBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the admin who provisioned this user."
        }
      },
      "required": ["uid", "name", "email", "role", "createdAt", "createdBy"]
    },
    "Mosque": {
      "title": "Mosque",
      "description": "Field documentation record of a mosque in Al-Qarabulli Awqaf office.",
      "type": "object",
      "properties": {
        "officialName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150,
          "description": "Official registered mosque name (الاسم الرسمي للمسجد)."
        },
        "commonName": {
          "type": "string",
          "minLength": 0,
          "maxLength": 150,
          "description": "Common local name if different (الاسم المتداول)."
        },
        "locality": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Locality or neighborhood name (المحلة / المنطقة)."
        },
        "landmark": {
          "type": "string",
          "minLength": 0,
          "maxLength": 200,
          "description": "Nearest clear landmark (علامة دالة)."
        },
        "notes": {
          "type": "string",
          "minLength": 0,
          "maxLength": 500,
          "description": "Optional field notes (ملاحظات)."
        },
        "mapsUrl": {
          "type": "string",
          "minLength": 25,
          "maxLength": 150,
          "pattern": "^https://www\\.google\\.com/maps\\?q=-?[0-9]+(\\.[0-9]+)?,-?[0-9]+(\\.[0-9]+)?$",
          "description": "Auto-generated Google Maps URL."
        },
        "lat": {
          "type": "number",
          "description": "Latitude coordinate."
        },
        "lng": {
          "type": "number",
          "description": "Longitude coordinate."
        },
        "accuracy": {
          "type": "number",
          "description": "GPS accuracy in meters."
        },
        "photos": {
          "type": "array",
          "description": "Up to 3 compressed JPEG base64 data URLs of the landmark."
        },
        "photoCount": {
          "type": "integer",
          "description": "Number of attached landmark photos (0-3)."
        },
        "createdBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the staff member who documented the mosque."
        },
        "createdByName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Display name of the staff member who documented the mosque."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of initial documentation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update."
        },
        "updatedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the staff member who last updated the record."
        },
        "osmId": {
          "type": "string",
          "minLength": 0,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]*$",
          "description": "Optional linked OpenStreetMap element ID (e.g., node_12345 or way_12345)."
        },
        "googlePlaceId": {
          "type": "string",
          "minLength": 0,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]*$",
          "description": "Optional linked Google Maps Place ID when documented from Google Maps."
        }
      },
      "required": [
        "officialName",
        "commonName",
        "locality",
        "landmark",
        "notes",
        "mapsUrl",
        "lat",
        "lng",
        "accuracy",
        "photos",
        "photoCount",
        "createdBy",
        "createdByName",
        "createdAt",
        "updatedAt",
        "updatedBy"
      ]
    },
    "OsmSettings": {
      "title": "OsmSettings",
      "description": "Manager-controlled settings for optional OpenStreetMap publishing.",
      "type": "object",
      "properties": {
        "osmPublishEnabled": {
          "type": "boolean",
          "description": "Whether the optional Publish to OpenStreetMap button is enabled for staff."
        },
        "osmUseProduction": {
          "type": "boolean",
          "description": "False uses OSM dev sandbox server; true uses production openstreetmap.org."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update."
        },
        "updatedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the manager who last updated the setting."
        }
      },
      "required": ["osmPublishEnabled", "osmUseProduction", "updatedAt", "updatedBy"]
    },
    "GoogleSheetsConfig": {
      "title": "GoogleSheetsConfig",
      "description": "Linked Google Sheets spreadsheet configuration and last sync status for Awqaf mosque records.",
      "type": "object",
      "properties": {
        "spreadsheetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Google Sheets spreadsheet ID."
        },
        "spreadsheetTitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "Display title of the linked Google Sheet."
        },
        "spreadsheetUrl": {
          "type": "string",
          "minLength": 15,
          "maxLength": 300,
          "pattern": "^https://docs\\.google\\.com/spreadsheets/.*$",
          "description": "Direct Google Sheets URL."
        },
        "sheetName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Selected worksheet tab name inside the spreadsheet."
        },
        "lastSyncedCount": {
          "type": "integer",
          "description": "Number of mosque rows written during last sync."
        },
        "lastSyncedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of the last sync."
        },
        "lastSyncedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the staff member who performed the last sync."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update."
        },
        "updatedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the staff member who updated the linked sheet config."
        }
      },
      "required": [
        "spreadsheetId",
        "spreadsheetTitle",
        "spreadsheetUrl",
        "sheetName",
        "lastSyncedCount",
        "lastSyncedAt",
        "lastSyncedBy",
        "updatedAt",
        "updatedBy"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Staff accounts with RBAC role (admin or documenter)."
    },
    "/mosques/{mosqueId}": {
      "schema": {
        "$ref": "#/entities/Mosque"
      },
      "description": "Documented mosque records created by office staff."
    },
    "/appSettings/{settingId}": {
      "schema": {
        "$ref": "#/entities/OsmSettings"
      },
      "description": "Office-wide manager settings such as optional OpenStreetMap publishing."
    },
    "/sheetSyncConfig/{configId}": {
      "schema": {
        "$ref": "#/entities/GoogleSheetsConfig"
      },
      "description": "Shared Google Sheets sync configuration for office mosque records."
    }
  }
}
